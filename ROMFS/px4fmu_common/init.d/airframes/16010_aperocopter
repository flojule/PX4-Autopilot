#!/bin/sh
#
# @name aperocopter (coaxial, per-blade tip flaps, coax_mixer)
#
# @type Coaxial Helicopter
# @class Copter
#
# @output Servo1 flap upper rotor blade 0 (via slip ring)
# @output Servo2 flap upper rotor blade 180
# @output Servo3 flap lower rotor blade 0
# @output Servo4 flap lower rotor blade 180
# @output Motor1 rotor speed (ESC)
#

. ${R}etc/init.d/rc.coax_defaults

# outputs (PX4IO): servos 1-4 on timers 0-1 (flap servo frame rate), motor 5; coax_mixer
param set-default PWM_MAIN_FUNC1 201
param set-default PWM_MAIN_FUNC2 202
param set-default PWM_MAIN_FUNC3 203
param set-default PWM_MAIN_FUNC4 204
param set-default PWM_MAIN_FUNC5 101
param set-default PWM_MAIN_TIM0 333
param set-default PWM_MAIN_TIM1 333

# rotor azimuth encoder on the upper mast (rotor_encoder): slot track FMU CH11, index track FMU CH12
param set-default RENC_EN 1
param set-default RENC_SLOTS 36
param set-default PWM_AUX_FUNC11 2071
param set-default PWM_AUX_FUNC12 2072
