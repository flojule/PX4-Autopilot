#!/bin/sh
#
# aperocopter coaxial defaults (coax_mixer, per-blade tip flaps): SIH 10046 and FMU 16010
#

. ${R}etc/init.d/rc.mc_defaults

param set-default MAV_TYPE 3

# roll/pitch and xy gains: free mast-top gimbal at 68 kg, tuned per payload mount and payload in
# aperocopter (config gains, tools.gimbal --tune; per payload: tools.gimbal --px4 KG, set by tools.sitl):
# fastest attitude step, then least wind position error, damping >= 0.5 attitude loop (vehicle modes),
# >= 0.4 cascade (damps the free swing), gimbal flying and locked. 421 N m cyclic flap authority (52.6 N m/deg both rotors x
# CM_CYC_MAX 8 deg at CM_RPM_REF 313, held by coax_mixer's (CM_RPM_REF / Omega)^2); rate I 1.5,
# limit 0.8 (337 N m) hold the rotor moments of airspeed
param set-default MC_ROLL_P 27
param set-default MC_PITCH_P 27
param set-default MC_ROLLRATE_P 0.6
param set-default MC_ROLLRATE_I 1.5
param set-default MC_RR_INT_LIM 0.8
param set-default MC_ROLLRATE_D 0
param set-default MC_PITCHRATE_P 0.6
param set-default MC_PITCHRATE_I 1.5
param set-default MC_PR_INT_LIM 0.8
param set-default MC_PITCHRATE_D 0
param set-default MC_YAWRATE_P 2.0
param set-default MC_YAWRATE_I 0.4
# yaw P 4: 20 deg step rise 0.3 s at 68 kg, 0.4 s at 0 kg (Python design 0.4-0.6 s)
param set-default MC_YAW_P 4
# velocity loop: D 0, the payload gimbal swing mode loses damping with acceleration feedback
param set-default MPC_XY_P 1.6
param set-default MPC_XY_VEL_P_ACC 1.8
param set-default MPC_XY_VEL_I_ACC 0.3
param set-default MPC_XY_VEL_D_ACC 0
# altitude: 1 m step rise 0.8 s at 68 kg, 1.3 s at 0 kg (Python design 0.75-0.95 s)
param set-default MPC_Z_P 1.5
param set-default MPC_Z_VEL_P_ACC 6

# gyro dynamic notch at 2/rev and 4/rev of the rotor (coax_mixer blade passage as ESC rpm), from
# 2/rev 6 Hz (180 rpm, 34-68 kg); off below, where 2/rev is inside the rate loop bandwidth.
# CM_NOTCH_ESC 0 if the ESC publishes esc_status telemetry
param set-default CM_NOTCH_ESC 1
param set-default IMU_GYRO_DNF_EN 1
param set-default IMU_GYRO_DNF_HMC 2
param set-default IMU_GYRO_DNF_BW 2
param set-default IMU_GYRO_DNF_MIN 3

# thrust ~ rotor speed^2: hover thrust 0.09 / 0.31 / 0.52 at 0 / 34 / 68 kg (CM_RPM_MAX 450, blade pitch 9.5 deg): set per payload
param set-default MPC_THR_HOVER 0.52
param set-default MPC_THR_MIN 0.05

# tip flap range (aperocopter config actuators.flap_servo.range_deg); measure flap angle vs PWM
param set-default CM_FLAP_MIN -15
param set-default CM_FLAP_MAX 15

# failsafes (aperocopter docs/requirements.md SAF-3, SAF-5, SAF-6); hold COM_FAIL_ACT_T, then act
param set-default COM_FAIL_ACT_T 10
# manual control (COM_RC_LOSS_T 0.5 s) or GCS link (COM_DL_LOSS_T 10 s) lost: land in place
param set-default NAV_RCL_ACT 3
param set-default NAV_DLL_ACT 3
# geofence: lane polygon from the GCS, 400 m from home, 65 m above home (cruise 30.5-60.9 m); breach: hold
# where detected (no prediction): place the fence 35 m inside the boundary along the lane (overshoot 20-41 m from 12 m/s, 0-68 kg)
param set-default GF_ACTION 2
param set-default GF_MAX_HOR_DIST 400
param set-default GF_MAX_VER_DIST 65
# battery: warning 15 %, return at 10 %, land at 5 % (BAT_EMERGEN_THR); set BAT1_CAPACITY and the
# cell voltages from the pack test
param set-default BAT_LOW_THR 0.15
param set-default BAT_CRIT_THR 0.10
param set-default BAT_EMERGEN_THR 0.05
param set-default COM_LOW_BAT_ACT 3
