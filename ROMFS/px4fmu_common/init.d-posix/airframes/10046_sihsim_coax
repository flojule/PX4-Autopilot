#!/bin/sh
#
# @name aperocopter coaxial SITL for SIH (libplant rotor model, coax_mixer per-blade tip flaps)
#
# @type Coaxial Helicopter
#
# Needs APEROCOPTER_PLANT=<file from: python -m tools.plant_py.params> (aperocopter repo).
#

. ${R}etc/init.d/rc.coax_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=sihsim}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=coax}

param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1
param set-default SENS_GNSS0_DELAY 0
param set-default SENS_GNSS1_DELAY 0

# 400 Hz simulation and mixer as on the FMU; px4-rc.simulator defaults 250 Hz
param set IMU_INTEG_RATE 400

# outputs as on the FMU: servos 1-4 (flaps upper 0/180, lower 0/180), motor 5 (rotor speed)
param set-default PWM_MAIN_FUNC1 201
param set-default PWM_MAIN_FUNC2 202
param set-default PWM_MAIN_FUNC3 203
param set-default PWM_MAIN_FUNC4 204
param set-default PWM_MAIN_FUNC5 101

# drag and damping from libplant (rotor) and the plant file (body)
param set-default SIH_KDV 0
param set-default SIH_KDW 0

param set SIH_VEHICLE_TYPE 6
